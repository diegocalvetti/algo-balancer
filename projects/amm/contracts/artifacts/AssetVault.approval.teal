	// i < totalAssets
	frame_dig 2 // i: uint64
	frame_dig 0 // totalAssets: uint64
	<
	bz *for_17_end

	// contracts/AssetVault.algo.ts:776
	// assetId = this.assetAt(i).value
	bytec 4 //  "asset_"
	frame_dig 2 // i: uint64
	itob
	concat
	box_get

	// box value does not exist: this.assetAt(i).value
	assert
	btoi
	frame_bury 3 // assetId: uint64

	// contracts/AssetVault.algo.ts:777
	// poolBalance = this.balances(assetId).value
	bytec 1 //  "balances_"
	frame_dig 3 // assetId: uint64
	itob
	concat
	box_get

	// box value does not exist: this.balances(assetId).value
	assert
	btoi
	frame_bury 4 // poolBalance: uint64

	// contracts/AssetVault.algo.ts:778
	// providedAmount = this.provided(sender).value[i]
	bytec 3 //  "provided_"
	frame_dig -1 // sender: Address
	concat
	box_get

	// box value does not exist: this.provided(sender).value
	assert
	extract 2 0
	store 255 // full array
	intc 0 //  initial offset
	frame_dig 2 // i: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	frame_bury 5 // providedAmount: uint64

	// contracts/AssetVault.algo.ts:780
	// assert(poolBalance > 0, 'Pool balance must be > 0')
	frame_dig 4 // poolBalance: uint64
	intc 0 // 0
	>

	// Pool balance must be > 0
	assert

	// contracts/AssetVault.algo.ts:784
	// assetRatio = wideRatio([providedAmount, SCALE], [poolBalance])
	frame_dig 5 // providedAmount: uint64
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig 4 // poolBalance: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 6 // assetRatio: uint64

	// *if16_condition
	// contracts/AssetVault.algo.ts:787
	// i === 0
	frame_dig 2 // i: uint64
	intc 0 // 0
	==
	bz *if16_else

	// *if16_consequent
	// contracts/AssetVault.algo.ts:788
	// referenceRatio = assetRatio
	frame_dig 6 // assetRatio: uint64
	frame_bury 1 // referenceRatio: uint64
	b *if16_end

*if16_else:
	// contracts/AssetVault.algo.ts:790
