	assert

*if16_end:

*for_17_continue:
	// contracts/AssetVault.algo.ts:775
	// i += 1
	frame_dig 2 // i: uint64
	intc 2 // 1
	+
	frame_bury 2 // i: uint64
	b *for_17

*for_17_end:
	// contracts/AssetVault.algo.ts:797
