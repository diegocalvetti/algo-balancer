// Opt the app into an ASA if it is not already opted in.
optIn:
	proto 1 0

	// *if6_condition
	// contracts/AssetVault.algo.ts:369
	// this.app.address.isOptedInToAsset(assetId)
	global CurrentApplicationAddress
	frame_dig -1 // assetId: AssetID
	asset_holding_get AssetBalance
	swap
	pop
	bz *if6_end

	// *if6_consequent
	// contracts/AssetVault.algo.ts:370
	// return;
	retsub

*if6_end:
	// contracts/AssetVault.algo.ts:373
	// sendAssetTransfer({
	//       assetReceiver: this.app.address,
	//       xferAsset: assetId,
	//       assetAmount: 0,
	//     })
	itxn_begin
	intc 4 //  axfer
	itxn_field TypeEnum

	// contracts/AssetVault.algo.ts:374
	// assetReceiver: this.app.address
	global CurrentApplicationAddress
	itxn_field AssetReceiver

	// contracts/AssetVault.algo.ts:375
	// xferAsset: assetId
	frame_dig -1 // assetId: AssetID
	itxn_field XferAsset

	// contracts/AssetVault.algo.ts:376
	// assetAmount: 0
	intc 0 // 0
	itxn_field AssetAmount

	// Fee field not set, defaulting to 0
	intc 0 // 0
	itxn_field Fee

	// Submit inner transaction
	itxn_submit
	retsub

// addToken(index: uint64, assetID: AssetID, weight: uint64): void
//
// Create the asset/weight/balance boxes for one token at `index`.
addToken:
	proto 3 0

	// *if7_condition
	// contracts/AssetVault.algo.ts:382
	// !this.assetAt(index).exists
	bytec 2 //  "asset_"
	frame_dig -1 // index: uint64
	itob
	concat
	box_len
	swap
	pop
	!
	bz *if7_end

	// *if7_consequent
	// contracts/AssetVault.algo.ts:383
	// this.assetAt(index).create(8)
	bytec 2 //  "asset_"
	frame_dig -1 // index: uint64
	itob
	concat
	intc 1 // 8
	box_create
	pop

*if7_end:
	// *if8_condition
	// contracts/AssetVault.algo.ts:386
	// !this.weights(index).exists
	bytec 4 //  "weights_"
	frame_dig -1 // index: uint64
	itob
	concat
	box_len
	swap
	pop
	!
	bz *if8_end

	// *if8_consequent
	// contracts/AssetVault.algo.ts:387
	// this.weights(index).create(8)
	bytec 4 //  "weights_"
	frame_dig -1 // index: uint64
	itob
	concat
	intc 1 // 8
	box_create
	pop

*if8_end:
	// *if9_condition
	// contracts/AssetVault.algo.ts:390
	// !this.balances(assetID).exists
	bytec 1 //  "balances_"
	frame_dig -2 // assetID: AssetID
	itob
	concat
	box_len
	swap
	pop
	!
	bz *if9_end

	// *if9_consequent
	// contracts/AssetVault.algo.ts:391
	// this.balances(assetID).create(8)
	bytec 1 //  "balances_"
	frame_dig -2 // assetID: AssetID
	itob
	concat
	intc 1 // 8
	box_create
	pop

*if9_end:
	// contracts/AssetVault.algo.ts:394
	// this.assetAt(index).value = assetID
	bytec 2 //  "asset_"
	frame_dig -1 // index: uint64
	itob
	concat
	frame_dig -2 // assetID: AssetID
	itob
	box_put

	// contracts/AssetVault.algo.ts:395
	// this.weights(index).value = weight
	bytec 4 //  "weights_"
	frame_dig -1 // index: uint64
	itob
	concat
	frame_dig -3 // weight: uint64
	itob
	box_put

	// contracts/AssetVault.algo.ts:396
	// this.balances(assetID).value = 0
	bytec 1 //  "balances_"
	frame_dig -2 // assetID: AssetID
	itob
	concat
	bytec 14 // 0x0000000000000000
	box_put
	retsub

// createToken(): void
//
// Create the pool's LP token (once). It is an ASA with this contract as manager
// and reserve, 6 decimals, and no clawback/freeze. Held in reserve and released
// as liquidity is minted.
createToken:
	proto 0 0

	// *if10_condition
	// contracts/AssetVault.algo.ts:405
	// this.token.value === AssetID.zeroIndex
	bytec 7 //  "token"
	app_global_get
	intc 0 // 0
	==
	bz *if10_end

	// *if10_consequent
	// contracts/AssetVault.algo.ts:406
	// this.token.value = sendAssetCreation({
	//         configAssetTotal: TOTAL_LP_SUPPLY,
	//         configAssetDecimals: 6,
	//         configAssetReserve: this.app.address,
	//         configAssetManager: this.app.address,
	//         configAssetClawback: globals.zeroAddress,
	//         configAssetFreeze: globals.zeroAddress,
	//         configAssetDefaultFrozen: 0,
	//         configAssetName: 'BalancedPool-' + this.app.id.toString(),
	//         configAssetUnitName: 'LP',
	//       })
	bytec 7 //  "token"
	itxn_begin
	pushint 3 // acfg
	itxn_field TypeEnum

	// contracts/AssetVault.algo.ts:407
	// configAssetTotal: TOTAL_LP_SUPPLY
	intc 5 // 10
	pushint 16
	exp
	itxn_field ConfigAssetTotal

	// contracts/AssetVault.algo.ts:408
	// configAssetDecimals: 6
	intc 6 // 6
	itxn_field ConfigAssetDecimals

	// contracts/AssetVault.algo.ts:409
	// configAssetReserve: this.app.address
	global CurrentApplicationAddress
	itxn_field ConfigAssetReserve

	// contracts/AssetVault.algo.ts:410
	// configAssetManager: this.app.address
	global CurrentApplicationAddress
	itxn_field ConfigAssetManager

	// contracts/AssetVault.algo.ts:411
	// configAssetClawback: globals.zeroAddress
	global ZeroAddress
	itxn_field ConfigAssetClawback

	// contracts/AssetVault.algo.ts:412
	// configAssetFreeze: globals.zeroAddress
	global ZeroAddress
	itxn_field ConfigAssetFreeze

	// contracts/AssetVault.algo.ts:413
	// configAssetDefaultFrozen: 0
	intc 0 // 0
	itxn_field ConfigAssetDefaultFrozen

	// contracts/AssetVault.algo.ts:414
	// configAssetName: 'BalancedPool-' + this.app.id.toString()
	pushbytes 0x42616c616e636564506f6f6c2d // "BalancedPool-"
	txna Applications 0
	callsub *itoa
	concat
	itxn_field ConfigAssetName

	// contracts/AssetVault.algo.ts:415
	// configAssetUnitName: 'LP'
	pushbytes 0x4c50 // "LP"
	itxn_field ConfigAssetUnitName

	// Fee field not set, defaulting to 0
	intc 0 // 0
	itxn_field Fee

	// Submit inner transaction
	itxn_submit
	itxn CreatedAssetID
	app_global_put

*if10_end:
	retsub

// assertIsManager(): void
assertIsManager:
	proto 0 0

	// contracts/AssetVault.algo.ts:421
	// assert(this.txn.sender === this.manager.value, 'only the manager can call this method')
	txn Sender
	bytec 15 //  "manager"
	app_global_get
	==

	// only the manager can call this method
	assert
	retsub

// assertIsBootstrapped(): void
assertIsBootstrapped:
	proto 0 0

	// contracts/AssetVault.algo.ts:425
	// assert(this.token.value !== AssetID.zeroIndex, 'pool not bootstrapped')
	bytec 7 //  "token"
	app_global_get
	intc 0 // 0
	!=

	// pool not bootstrapped
	assert
	retsub

// assertNoWeightTransition(): void
assertNoWeightTransition:
	proto 0 0

	// contracts/AssetVault.algo.ts:429
	// assert(this.startRound.value === 0 && this.startRound.value === this.endRound.value)
	bytec 9 //  "start_round"
	app_global_get
	intc 0 // 0
	==
	dup
	bz *skip_and1
	bytec 9 //  "start_round"
	app_global_get
	bytec 8 //  "end_round"
	app_global_get
	==
	&&

*skip_and1:
	assert
	retsub

// lnWithSign(x: uint64): uint64[]
//
// Fixed-point ln(x) via the Mercator series around 1, with a sign flag.
// For x < 1 it computes ln(1/x) and flags the result negative, keeping precision.
//
// @param x - value scaled by SCALE (must be > 0).
// @returns [negative, |ln(x)| scaled by SCALE], negative = 1 when ln(x) < 0.
lnWithSign:
	proto 1 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 5

	// contracts/AssetVault.algo.ts:440
	// assert(x > 0, 'log undefined for x ≤ 0')
	frame_dig -1 // x: uint64
	intc 0 // 0
	>

	// log undefined for x ≤ 0
	assert

	// contracts/AssetVault.algo.ts:442
	// negative: uint64 = 0
	intc 0 // 0
	frame_bury 0 // negative: uint64

	// *if11_condition
	// contracts/AssetVault.algo.ts:445
	// x < SCALE
	frame_dig -1 // x: uint64
	intc 3 // 1000000
	<
	bz *if11_else

	// *if11_consequent
	// contracts/AssetVault.algo.ts:446
	// negative = 1
	intc 2 // 1
	frame_bury 0 // negative: uint64

	// contracts/AssetVault.algo.ts:447
	// invX = wideRatio([SCALE, SCALE], [x])
	intc 3 // 1000000
	dup
	mulw
	intc 0 // 0
	frame_dig -1 // x: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 2 // invX: uint64

	// contracts/AssetVault.algo.ts:448
	// z = wideRatio([invX - SCALE, SCALE], [invX])
	frame_dig 2 // invX: uint64
	intc 3 // 1000000
	-
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig 2 // invX: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // z: uint64
	b *if11_end

*if11_else:
	// contracts/AssetVault.algo.ts:450
	// z = wideRatio([x - SCALE, SCALE], [x])
	frame_dig -1 // x: uint64
	intc 3 // 1000000
	-
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig -1 // x: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // z: uint64

*if11_end:
	// contracts/AssetVault.algo.ts:454
	// result = z
	frame_dig 1 // z: uint64
	frame_bury 3 // result: uint64

	// contracts/AssetVault.algo.ts:455
	// term = z
	frame_dig 1 // z: uint64
	frame_bury 4 // term: uint64

	// contracts/AssetVault.algo.ts:457
	// increaseOpcodeBudget()
	itxn_begin
	intc 6 //  appl
	itxn_field TypeEnum
	intc 0 // 0
	itxn_field Fee
	bytec 10 //  #pragma version 10; int 1
	dup
	itxn_field ApprovalProgram
	itxn_field ClearStateProgram
	intc 7 //  DeleteApplication
	itxn_field OnCompletion
	itxn_submit

	// contracts/AssetVault.algo.ts:459
	// for (let i = 2; i <= 10; i = i + 1)
	pushint 2
	frame_bury 5 // i: uint64

*for_10:
	// contracts/AssetVault.algo.ts:459
	// i <= 10
	frame_dig 5 // i: uint64
	intc 5 // 10
	<=
	bz *for_10_end

	// contracts/AssetVault.algo.ts:460
	// term = wideRatio([term, z], [SCALE])
	frame_dig 4 // term: uint64
	frame_dig 1 // z: uint64
	mulw
	intc 0 // 0
	intc 3 // 1000000
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 4 // term: uint64

	// contracts/AssetVault.algo.ts:461
	// result = result + wideRatio([term], [i])
	frame_dig 3 // result: uint64
	intc 0 // 0
	frame_dig 4 // term: uint64
	intc 0 // 0
	frame_dig 5 // i: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	+
	frame_bury 3 // result: uint64

*for_10_continue:
	// contracts/AssetVault.algo.ts:459
	// i = i + 1
	frame_dig 5 // i: uint64
	intc 2 // 1
	+
	frame_bury 5 // i: uint64
	b *for_10

*for_10_end:
	// contracts/AssetVault.algo.ts:464
	// return [negative, result];
	frame_dig 0 // negative: uint64
	itob
	frame_dig 3 // result: uint64
	itob
	concat

	// set the subroutine return value
	frame_bury 0

	// pop all local variables from the stack
	popn 5
	retsub

// exp(x: uint64): uint64
//
// Fixed-point e^x via a 10-term Taylor series.
//
// @param x - exponent scaled by SCALE.
// @returns e^x scaled by SCALE.
exp:
	proto 1 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 2

	// contracts/AssetVault.algo.ts:474
	// result = SCALE
	intc 3 // 1000000
	frame_bury 0 // result: uint64

	// contracts/AssetVault.algo.ts:475
	// term = SCALE
	intc 3 // 1000000
	frame_bury 1 // term: uint64

	// contracts/AssetVault.algo.ts:477
	// for (let i = 1; i <= 10; i = i + 1)
	intc 2 // 1
	frame_bury 2 // i: uint64

*for_11:
	// contracts/AssetVault.algo.ts:477
	// i <= 10
	frame_dig 2 // i: uint64
	intc 5 // 10
	<=
	bz *for_11_end

	// contracts/AssetVault.algo.ts:478
	// term = wideRatio([term, x], [i * SCALE])
	frame_dig 1 // term: uint64
	frame_dig -1 // x: uint64
	mulw
	intc 0 // 0
	frame_dig 2 // i: uint64
	intc 3 // 1000000
	*
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // term: uint64

	// contracts/AssetVault.algo.ts:479
	// result += term
	frame_dig 0 // result: uint64
	frame_dig 1 // term: uint64
	+
	frame_bury 0 // result: uint64

*for_11_continue:
	// contracts/AssetVault.algo.ts:477
	// i = i + 1
	frame_dig 2 // i: uint64
	intc 2 // 1
	+
	frame_bury 2 // i: uint64
	b *for_11

*for_11_end:
	// contracts/AssetVault.algo.ts:482
	// return result;
	frame_dig 0 // result: uint64

	// set the subroutine return value
	frame_bury 0

	// pop all local variables from the stack
	popn 2
	retsub

// pow(x: uint64, y: uint64): uint64
//
// Fixed-point x^y, computed as exp(y * ln(x)) with sign-aware ln for x < 1.
// Accuracy degrades for ratios far from 1 (series truncation).
//
// @param x - base scaled by SCALE.
// @param y - exponent scaled by SCALE.
// @returns x^y scaled by SCALE.
pow:
	proto 2 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 4

	// *if12_condition
	// contracts/AssetVault.algo.ts:494
	// x === 0
	frame_dig -1 // x: uint64
	intc 0 // 0
	==
	bz *if12_end

	// *if12_consequent
	// contracts/AssetVault.algo.ts:494
	// return 0;
	intc 0 // 0
	b *pow*return

*if12_end:
	// contracts/AssetVault.algo.ts:496
	// lnXResult = this.lnWithSign(x)
	frame_dig -1 // x: uint64
	callsub lnWithSign
	frame_bury 0 // lnXResult: uint64[]

	// contracts/AssetVault.algo.ts:497
	// negativeLn = lnXResult[0]
	frame_dig 0 // lnXResult: uint64[]
	store 255 // full array
	load 255 // full array
	extract 0 8
	btoi
	frame_bury 1 // negativeLn: uint64

	// contracts/AssetVault.algo.ts:498
	// lnX = lnXResult[1]
	frame_dig 0 // lnXResult: uint64[]
	store 255 // full array
	load 255 // full array
	extract 8 8
	btoi
	frame_bury 2 // lnX: uint64

	// contracts/AssetVault.algo.ts:500
	// ylnX = wideRatio([y, lnX], [SCALE])
	frame_dig -2 // y: uint64
	frame_dig 2 // lnX: uint64
	mulw
	intc 0 // 0
	intc 3 // 1000000
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 3 // ylnX: uint64

	// contracts/AssetVault.algo.ts:502
	// expResult = this.exp(ylnX)
	frame_dig 3 // ylnX: uint64
	callsub exp
	frame_bury 4 // expResult: uint64

	// *if13_condition
	// contracts/AssetVault.algo.ts:504
	// negativeLn === 1
	frame_dig 1 // negativeLn: uint64
	intc 2 // 1
	==
	bz *if13_end

	// *if13_consequent
	// contracts/AssetVault.algo.ts:505
	// return wideRatio([SCALE, SCALE], [expResult]);
	intc 3 // 1000000
	dup
	mulw
	intc 0 // 0
	frame_dig 4 // expResult: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	b *pow*return

*if13_end:
	// contracts/AssetVault.algo.ts:508
	// return expResult;
	frame_dig 4 // expResult: uint64

*pow*return:
	// set the subroutine return value
	frame_bury 0

	// pop all local variables from the stack
	popn 4
	retsub

// calcOut(balanceIn: uint64, weightIn: uint64, balanceOut: uint64, weightOut: uint64, amountIn: uint64): uint64
//
// Weighted constant-mean swap output, with a swap fee on the input:
//
// amountOut = balanceOut * (1 - (balanceIn / (balanceIn + amountInWithFee)) ^ (weightIn / weightOut))
//
// @param balanceIn  - input asset balance.
// @param weightIn   - input asset weight (scaled by SCALE).
// @param balanceOut - output asset balance.
// @param weightOut  - output asset weight (scaled by SCALE).
// @param amountIn   - input amount sent by the user.
// @returns the output amount.
calcOut:
	proto 5 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 3

	// contracts/AssetVault.algo.ts:532
	// amountInWithFee = wideRatio([amountIn, SCALE - fee], [SCALE])
	frame_dig -5 // amountIn: uint64
	pushint 999000
	mulw
	intc 0 // 0
	intc 3 // 1000000
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 0 // amountInWithFee: uint64

	// contracts/AssetVault.algo.ts:534
	// ratio = wideRatio([balanceIn, SCALE], [balanceIn + amountInWithFee])
	frame_dig -1 // balanceIn: uint64
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig -1 // balanceIn: uint64
	frame_dig 0 // amountInWithFee: uint64
	+
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // ratio: uint64

	// contracts/AssetVault.algo.ts:536
	// power = wideRatio([weightIn, SCALE], [weightOut])
	frame_dig -2 // weightIn: uint64
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig -4 // weightOut: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 2 // power: uint64

	// contracts/AssetVault.algo.ts:538
	// ratioPow = this.pow(ratio, power)
	frame_dig 2 // power: uint64
	frame_dig 1 // ratio: uint64
	callsub pow
	frame_bury 3 // ratioPow: uint64

	// contracts/AssetVault.algo.ts:540
	// return wideRatio([balanceOut, SCALE - ratioPow], [SCALE]);
	frame_dig -3 // balanceOut: uint64
	intc 3 // 1000000
	frame_dig 3 // ratioPow: uint64
	-
	mulw
	intc 0 // 0
	intc 3 // 1000000
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert

	// set the subroutine return value
	frame_bury 0

	// pop all local variables from the stack
	popn 3
	retsub

// computeNAssetsLiquidity(sender: Address): uint64
//
// LP to mint for a proportional deposit.
//
// Every asset must grow by the same fraction k of its balance (within 0.5%),
// otherwise the deposit is not invariant-preserving and is rejected — this also
// blocks single-sided deposits. Because the deposit grows the invariant by
// (1 + k) and Σ weights = 1, the LP supply must grow by exactly k:
//
// minted = totalLP * k
//
// This is linear and exact — no per-asset pow is needed once proportionality is
// enforced. Clears the sender's `provided` slots as it reads them.
//
// @param sender - the provider whose deposit is being priced.
// @returns the LP amount to mint.
computeNAssetsLiquidity:
	proto 1 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 6

	// contracts/AssetVault.algo.ts:560
	// totalAssets = this.numAssets.value
	bytec 3 //  "num_assets"
	app_global_get
	frame_bury 0 // totalAssets: uint64

	// contracts/AssetVault.algo.ts:561
	// assert(totalAssets >= 1, 'Please provide at least one asset')
	frame_dig 0 // totalAssets: uint64
	intc 2 // 1
	>=

	// Please provide at least one asset
	assert

	// contracts/AssetVault.algo.ts:563
	// referenceRatio: uint64 = 0
	intc 0 // 0
	frame_bury 1 // referenceRatio: uint64

	// contracts/AssetVault.algo.ts:565
	// for (let i = 0; i < totalAssets; i += 1)
	intc 0 // 0
	frame_bury 2 // i: uint64

*for_12:
	// contracts/AssetVault.algo.ts:565
	// i < totalAssets
	frame_dig 2 // i: uint64
	frame_dig 0 // totalAssets: uint64
	<
	bz *for_12_end

	// contracts/AssetVault.algo.ts:566
	// assetId = this.assetAt(i).value
	bytec 2 //  "asset_"
	frame_dig 2 // i: uint64
	itob
	concat
	box_get

	// box value does not exist: this.assetAt(i).value
	assert
	btoi
	frame_bury 3 // assetId: uint64

	// contracts/AssetVault.algo.ts:567
	// poolBalance = this.balances(assetId).value
	bytec 1 //  "balances_"
	frame_dig 3 // assetId: uint64
	itob
	concat
	box_get

	// box value does not exist: this.balances(assetId).value
	assert
	btoi
	frame_bury 4 // poolBalance: uint64

	// contracts/AssetVault.algo.ts:568
	// providedAmount = this.provided(sender).value[i]
	bytec 6 //  "provided_"
	frame_dig -1 // sender: Address
	concat
	box_get

	// box value does not exist: this.provided(sender).value
	assert
	extract 2 0
	store 255 // full array
	intc 0 //  initial offset
	frame_dig 2 // i: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	frame_bury 5 // providedAmount: uint64

	// contracts/AssetVault.algo.ts:570
	// assert(poolBalance > 0, 'Pool balance must be > 0')
	frame_dig 4 // poolBalance: uint64
	intc 0 // 0
	>

	// Pool balance must be > 0
	assert

	// contracts/AssetVault.algo.ts:573
	// assetRatio = wideRatio([providedAmount, SCALE], [poolBalance - providedAmount])
	frame_dig 5 // providedAmount: uint64
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig 4 // poolBalance: uint64
	frame_dig 5 // providedAmount: uint64
	-
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 6 // assetRatio: uint64

	// *if14_condition
	// contracts/AssetVault.algo.ts:576
	// i === 0
