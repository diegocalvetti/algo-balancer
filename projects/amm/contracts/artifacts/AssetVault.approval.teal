	frame_dig -2 // newWeights: uint64[]
	len
	intc 1 // 8
	/
	bytec 2 //  "num_assets"
	app_global_get
	==

	// weights length must match assets
	assert

	// contracts/AssetVault.algo.ts:534
	// sumOfWeights: uint64 = 0
	intc 0 // 0
	frame_bury 0 // sumOfWeights: uint64

	// contracts/AssetVault.algo.ts:535
	// for (let i = 0; i < newWeights.length; i += 1)
	intc 0 // 0
	frame_bury 1 // i: uint64

*for_11:
	// contracts/AssetVault.algo.ts:535
	// i < newWeights.length
	frame_dig 1 // i: uint64
	frame_dig -2 // newWeights: uint64[]
	len
	intc 1 // 8
	/
	<
	bz *for_11_end

	// contracts/AssetVault.algo.ts:536
	// assert(newWeights[i] >= MIN_WEIGHT, 'weight too small')
	frame_dig -2 // newWeights: uint64[]
	store 255 // full array
	intc 0 //  initial offset
	frame_dig 1 // i: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	intc 9 // 10000
	>=

	// weight too small
	assert

	// contracts/AssetVault.algo.ts:537
	// sumOfWeights += newWeights[i]
	frame_dig 0 // sumOfWeights: uint64
	frame_dig -2 // newWeights: uint64[]
	store 255 // full array
	intc 0 //  initial offset
	frame_dig 1 // i: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	+
	frame_bury 0 // sumOfWeights: uint64

*for_11_continue:
	// contracts/AssetVault.algo.ts:535
	// i += 1
	frame_dig 1 // i: uint64
	intc 2 // 1
	+
	frame_bury 1 // i: uint64
	b *for_11

*for_11_end:
	// contracts/AssetVault.algo.ts:539
	// assert(this.absDiff(sumOfWeights, SCALE) <= 1, 'weights must sum to 1')
	intc 3 // 1000000
	frame_dig 0 // sumOfWeights: uint64
	callsub absDiff
