// @param newWeights - target weight per asset (each >= MIN_WEIGHT, summing to SCALE).
// @returns the round at which the transition ends (0 if instant).
changeWeights:
	proto 2 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 4

	// contracts/AssetVault.algo.ts:528
	// this.assertIsManager()
	callsub assertIsManager

	// contracts/AssetVault.algo.ts:529
	// this.assertIsBootstrapped()
	callsub assertIsBootstrapped

	// contracts/AssetVault.algo.ts:530
	// this.assertNoWeightTransition()
	callsub assertNoWeightTransition

	// contracts/AssetVault.algo.ts:532
