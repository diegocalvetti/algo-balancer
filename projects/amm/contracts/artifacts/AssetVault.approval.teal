	frame_dig 0 // totalAssets: uint64
	intc 2 // 1
	>=

	// Please provide at least one asset
	assert

	// contracts/AssetVault.algo.ts:773
	// referenceRatio: uint64 = 0
	intc 0 // 0
	frame_bury 1 // referenceRatio: uint64

	// contracts/AssetVault.algo.ts:775
