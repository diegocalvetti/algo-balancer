	// contracts/AssetVault.algo.ts:655
	// negative = 1
	intc 2 // 1
	frame_bury 0 // negative: uint64

	// contracts/AssetVault.algo.ts:656
	// invX = wideRatio([SCALE, SCALE], [x])
	intc 3 // 1000000
	dup
	mulw
	intc 0 // 0
	frame_dig -1 // x: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 2 // invX: uint64

	// contracts/AssetVault.algo.ts:657
	// z = wideRatio([invX - SCALE, SCALE], [invX])
	frame_dig 2 // invX: uint64
	intc 3 // 1000000
	-
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig 2 // invX: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // z: uint64
	b *if13_end

*if13_else:
	// contracts/AssetVault.algo.ts:659
	// z = wideRatio([x - SCALE, SCALE], [x])
	frame_dig -1 // x: uint64
	intc 3 // 1000000
	-
	intc 3 // 1000000
	mulw
	intc 0 // 0
	frame_dig -1 // x: uint64
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
	assert
	frame_bury 1 // z: uint64

*if13_end:
	// contracts/AssetVault.algo.ts:663
	// result = z
	frame_dig 1 // z: uint64
	frame_bury 3 // result: uint64

	// contracts/AssetVault.algo.ts:664
	// term = z
	frame_dig 1 // z: uint64
	frame_bury 4 // term: uint64

	// contracts/AssetVault.algo.ts:666
	// increaseOpcodeBudget()
	itxn_begin
	intc 5 //  appl
