	intc 5 // 10
	/
	intc 0 // 0
	>
	bz *itoa_ternary_false
	frame_dig -1 // i: uint64
	intc 5 // 10
	/
	callsub *itoa
	b *itoa_ternary_end

*itoa_ternary_false:
