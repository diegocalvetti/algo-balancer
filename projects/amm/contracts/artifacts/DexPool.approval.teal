// swap(from: uint64, to: uint64, minAmountOut: uint64, transferTxn: AssetTransferTxn): uint64
//
// Execute a token swap against the pool.
//
// Fee logic:
// - The active arbitrageur trades fee-free (effectiveFee = 0), allowing
// profitable correction of price discrepancies with external markets.
// - All other callers pay feeRate (set by the arbitrageur; DEFAULT_FEE_RATE
// when no arbitrageur is active).
//
// Fee revenue stays inside the pool: the full amountIn enters the balance,
// growing the invariant V. The arbitrageur captures this growth indirectly
// by holding LP tokens or by withdrawing via burnLiquidity at epoch end.
//
// @param from         - Index of the input asset.
// @param to           - Index of the output asset.
// @param minAmountOut - Slippage guard: reverts if computed output < this value.
// @param transferTxn  - Asset transfer carrying the input amount.
// @returns The output amount transferred to the caller.
swap:
	proto 4 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dupn 9

	// contracts/DexPool.algo.ts:424
	// this.assertIsBootstrapped()
	callsub assertIsBootstrapped

	// contracts/DexPool.algo.ts:425
	// this.tryFinalizeWeights()
	callsub tryFinalizeWeights

	// contracts/DexPool.algo.ts:426
	// increaseOpcodeBudget()
	itxn_begin
	intc 6 //  appl
	itxn_field TypeEnum
	intc 0 // 0
	itxn_field Fee
	bytec 17 //  #pragma version 10; int 1
	dup
	itxn_field ApprovalProgram
	itxn_field ClearStateProgram
	intc 9 //  DeleteApplication
	itxn_field OnCompletion
	itxn_submit

	// contracts/DexPool.algo.ts:428
	// sender = transferTxn.sender
	frame_dig -4 // transferTxn: AssetTransferTxn
	gtxns Sender
	frame_bury 0 // sender: address

	// contracts/DexPool.algo.ts:429
	// amount = transferTxn.assetAmount
	frame_dig -4 // transferTxn: AssetTransferTxn
	gtxns AssetAmount
	frame_bury 1 // amount: uint64

	// contracts/DexPool.algo.ts:431
	// assetIn = this.assets.value[from]
	bytec 1 //  "assets"
	app_global_get
	extract 2 0
	store 255 // full array
	intc 0 //  initial offset
	frame_dig -1 // from: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	frame_bury 2 // assetIn: uint64

	// contracts/DexPool.algo.ts:432
	// assetOut = this.assets.value[to]
	bytec 1 //  "assets"
	app_global_get
	extract 2 0
	store 255 // full array
	intc 0 //  initial offset
	frame_dig -2 // to: uint64
	intc 1 // 8
	* // acc * typeLength
	+
	load 255 // full array
	swap
	intc 1 // 8
	extract3
	btoi
	frame_bury 3 // assetOut: uint64

	// contracts/DexPool.algo.ts:434
	// assert(transferTxn.xferAsset === assetIn, 'wrong input asset')
	frame_dig -4 // transferTxn: AssetTransferTxn
	gtxns XferAsset
	frame_dig 2 // assetIn: uint64
	==

	// wrong input asset
	assert

	// contracts/DexPool.algo.ts:435
	// assert(transferTxn.assetReceiver === this.app.address, 'input must be sent to the pool')
	frame_dig -4 // transferTxn: AssetTransferTxn
	gtxns AssetReceiver
	global CurrentApplicationAddress
	==

	// input must be sent to the pool
	assert

	// contracts/DexPool.algo.ts:437
	// balanceIn = this.balances(assetIn).value
	bytec 2 //  "balances_"
	frame_dig 2 // assetIn: uint64
	itob
	concat
	box_get

	// box value does not exist: this.balances(assetIn).value
	assert
	btoi
	frame_bury 4 // balanceIn: uint64

	// contracts/DexPool.algo.ts:438
	// balanceOut = this.balances(assetOut).value
	bytec 2 //  "balances_"
	frame_dig 3 // assetOut: uint64
	itob
	concat
	box_get

	// box value does not exist: this.balances(assetOut).value
	assert
	btoi
	frame_bury 5 // balanceOut: uint64

	// contracts/DexPool.algo.ts:440
	// weightIn = this.getCurrentWeight(from)
	frame_dig -1 // from: uint64
	callsub getCurrentWeight
	frame_bury 6 // weightIn: uint64

	// contracts/DexPool.algo.ts:441
	// weightOut = this.getCurrentWeight(to)
	frame_dig -2 // to: uint64
	callsub getCurrentWeight
	frame_bury 7 // weightOut: uint64

	// contracts/DexPool.algo.ts:444
	// effectiveFee = sender === this.currentArbitrageur.value ? 0 : this.feeRate.value
	frame_dig 0 // sender: address
	bytec 10 //  "current_arbitrageur"
	app_global_get
	==
	bz *ternary0_false
	intc 0 // 0
	b *ternary0_end

*ternary0_false:
	bytec 13 //  "fee_rate"
	app_global_get

*ternary0_end:
	frame_bury 8 // effectiveFee: uint64

	// contracts/DexPool.algo.ts:446
	// amountOut = this.calcOut(balanceIn, weightIn, balanceOut, weightOut, amount, effectiveFee)
	frame_dig 8 // effectiveFee: uint64
	frame_dig 1 // amount: uint64
	frame_dig 7 // weightOut: uint64
	frame_dig 5 // balanceOut: uint64
	frame_dig 6 // weightIn: uint64
	frame_dig 4 // balanceIn: uint64
	callsub calcOut
	frame_bury 9 // amountOut: uint64

	// contracts/DexPool.algo.ts:448
	// assert(amountOut >= minAmountOut, 'slippage exceeded')
	frame_dig 9 // amountOut: uint64
	frame_dig -3 // minAmountOut: uint64
	>=

	// slippage exceeded
	assert

	// contracts/DexPool.algo.ts:450
	// this.balances(assetIn).value = balanceIn + amount
	bytec 2 //  "balances_"
	frame_dig 2 // assetIn: uint64
	itob
	concat
	frame_dig 4 // balanceIn: uint64
	frame_dig 1 // amount: uint64
	+
	itob
	box_put

	// contracts/DexPool.algo.ts:451
	// this.balances(assetOut).value = balanceOut - amountOut
	bytec 2 //  "balances_"
	frame_dig 3 // assetOut: uint64
	itob
	concat
	frame_dig 5 // balanceOut: uint64
	frame_dig 9 // amountOut: uint64
	-
	itob
	box_put

	// contracts/DexPool.algo.ts:453
	// sendAssetTransfer({
	//       assetReceiver: sender,
	//       assetAmount: amountOut,
	//       xferAsset: assetOut,
	//     })
	itxn_begin
	intc 4 //  axfer
	itxn_field TypeEnum

	// contracts/DexPool.algo.ts:454
	// assetReceiver: sender
	frame_dig 0 // sender: address
	itxn_field AssetReceiver

	// contracts/DexPool.algo.ts:455
	// assetAmount: amountOut
