// initPool(poolID: AppID, type: uint64, assetIds: AssetID[], weights: uint64[], coverMBR: PayTxn): AssetID
//
// Initialize the pool with the given assets & weights
// @param {AppID} poolID - Pool App ID
// @param type
// @param {AssetID[]} assetIds
// @param {uint64[]} weights
// @param coverMBR
initPool:
	proto 5 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	bytec 0 // 0x
	dup

	// contracts/Factory.algo.ts:154
	// verifyPayTxn(coverMBR, {
	//       receiver: poolID.address,
	//       amount: MBR_INIT_POOL, // @todo globals.assetOptInMinBalance * assetIds.length + globals.assetCreateMinBalance,
	//     })
	// verify receiver
	frame_dig -5 // coverMBR: PayTxn
	gtxns Receiver
	frame_dig -1 // poolID: AppID
	app_params_get AppAddress
	pop
	==

	// transaction verification failed: {"txn":"coverMBR","field":"receiver","expected":"poolID.address"}
	assert

	// verify amount
	frame_dig -5 // coverMBR: PayTxn
	gtxns Amount
	intc 6 // 1000000
	==

	// transaction verification failed: {"txn":"coverMBR","field":"amount","expected":"MBR_INIT_POOL"}
	assert

	// contracts/Factory.algo.ts:158
	// assert(assetIds.length >= 2, 'At least 2 tokens needed')
	frame_dig -3 // assetIds: AssetID[]
	len
	intc 1 // 8
	/
	pushint 2
	>=

	// At least 2 tokens needed
	assert

	// contracts/Factory.algo.ts:161
	// assert(assetIds.length <= 100, 'Maximum of 100 assets per pool')
	frame_dig -3 // assetIds: AssetID[]
	len
	intc 1 // 8
	/
	pushint 100
	<=

	// Maximum of 100 assets per pool
	assert

	// contracts/Factory.algo.ts:162
	// assert(assetIds.length === weights.length, 'Weights and Assets length must be the same')
	frame_dig -3 // assetIds: AssetID[]
	len
	intc 1 // 8
	/
	frame_dig -4 // weights: uint64[]
	len
	intc 1 // 8
	/
	==

	// Weights and Assets length must be the same
	assert

	// contracts/Factory.algo.ts:163
	// assert(this.listIsOrdered(assetIds), 'Assets must be ordered by ID')
	frame_dig -3 // assetIds: AssetID[]
	callsub listIsOrdered

	// Assets must be ordered by ID
	assert

	// *if4_condition
	// contracts/Factory.algo.ts:165
	// type === DEX_POOL_TYPE
	frame_dig -2 // type: uint64
	intc 0 // 1
	==
	bz *if4_end

	// *if4_consequent
	// contracts/Factory.algo.ts:166
	// hash = this.getPoolHash(assetIds, weights)
	frame_dig -4 // weights: uint64[]
	frame_dig -3 // assetIds: AssetID[]
	callsub getPoolHash
	frame_bury 0 // hash: byte[32]

	// contracts/Factory.algo.ts:167
	// assert(!this.pools(hash).exists, 'This pool already exists')
	bytec 4 //  "pools_"
	frame_dig 0 // hash: byte[32]
	concat
	box_len
	swap
	pop
	!

	// This pool already exists
	assert

	// contracts/Factory.algo.ts:168
	// this.pools(hash).value = { id: poolID, type: type, assets: assetIds, weights: weights }
	bytec 4 //  "pools_"
	frame_dig 0 // hash: byte[32]
	concat
	dup
	box_del
	pop
	bytec 0 //  initial head
	bytec 0 //  initial tail
	pushbytes 0x0014 // initial head offset
	frame_dig -2 // type: uint64
	itob
	callsub *process_static_tuple_element
	frame_dig -1 // poolID: AppID
	itob
	callsub *process_static_tuple_element
	frame_dig -3 // assetIds: AssetID[]
	dup
	len
	intc 1 // 8
	/
	itob
	extract 6 2
	swap
	concat
	callsub *process_dynamic_tuple_element
	frame_dig -4 // weights: uint64[]
	dup
	len
	intc 1 // 8
	/
	itob
	extract 6 2
	swap
	concat
	callsub *process_dynamic_tuple_element
	pop // pop head offset
	concat // concat head and tail
	box_put

*if4_end:
	// contracts/Factory.algo.ts:171
	// LPTokenID: AssetID = AssetID.zeroIndex
	intc 2 // 0
	frame_bury 1 // LPTokenID: AssetID

	// *if5_condition
	// contracts/Factory.algo.ts:173
	// type === DEX_POOL_TYPE
	frame_dig -2 // type: uint64
	intc 0 // 1
	==
	bz *if5_end

	// *if5_consequent
	// contracts/Factory.algo.ts:174
	// LPTokenID = sendMethodCall<typeof DexPool.prototype.bootstrap, AssetID>({
	//         applicationID: poolID,
	//         methodArgs: [assetIds, weights, 20, 5, this.txn.sender],
	//       })
	itxn_begin
	intc 3 //  appl
	itxn_field TypeEnum
	pushbytes 0x9fc85964 // method "bootstrap(uint64[],uint64[],uint64,uint64,address)uint64"
	itxn_field ApplicationArgs

	// contracts/Factory.algo.ts:175
	// applicationID: poolID
	frame_dig -1 // poolID: AppID
	itxn_field ApplicationID

	// contracts/Factory.algo.ts:176
	// methodArgs: [assetIds, weights, 20, 5, this.txn.sender]
	frame_dig -3 // assetIds: AssetID[]
	dup
	len
	intc 1 // 8
	/
	itob
	extract 6 2
	swap
	concat
	itxn_field ApplicationArgs
	frame_dig -4 // weights: uint64[]
	dup
	len
	intc 1 // 8
	/
	itob
	extract 6 2
	swap
	concat
	itxn_field ApplicationArgs
	pushbytes 0x0000000000000014
	itxn_field ApplicationArgs
	pushbytes 0x0000000000000005
	itxn_field ApplicationArgs
	txn Sender
	itxn_field ApplicationArgs

	// Fee field not set, defaulting to 0
	intc 2 // 0
	itxn_field Fee

	// Submit inner transaction
	itxn_submit
	itxn NumLogs
	intc 0 // 1
	-
	itxnas Logs
	extract 4 0
	btoi
	frame_bury 1 // LPTokenID: AssetID

*if5_end:
